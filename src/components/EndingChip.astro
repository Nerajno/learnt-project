---
// #32 Garden ledger: how a project ended. Successors use the support accent
// (Highlighter Plum); a composted project with no recorded cause gets a warning
// chip with a triangle marker, so the gap is never shown by colour alone.
import type { Project } from "../data/projects";
import { getEnding } from "../lib/ledger";

interface Props {
  project: Project;
  successor?: Project; // resolved supersededBy, for its title
}

const { project, successor } = Astro.props;
const ending = getEnding(project);
---

{ending.kind === "shipped" && <span class="ending ending--plain" data-ending="shipped">shipped and closed out</span>}
{ending.kind === "cause" && <span class="ending ending--plain" data-ending="cause">{ending.label}</span>}
{ending.kind === "successor" && (
  <span class="ending ending--successor" data-ending="successor">
    {ending.verb} → <a href={`/learnt/${ending.slug}`}>{successor?.title ?? ending.slug}</a>
  </span>
)}
{ending.kind === "missing" && (
  <span class="ending ending--missing" data-ending="missing">
    <svg width="10" height="9" viewBox="0 0 10 9" aria-hidden="true"><path d="M5 0 10 9H0Z" fill="currentColor" /></svg>
    cause not recorded
  </span>
)}

<style>
  .ending {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .ending--plain {
    color: var(--text-soft);
  }
  .ending--successor,
  .ending--missing {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  .ending--successor {
    background: var(--accent-2-soft);
    color: var(--accent-2);
  }
  .ending--successor a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ending--missing {
    background: var(--warning);
    color: var(--on-warning);
  }
</style>
