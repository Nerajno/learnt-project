---
import type { Project } from "../data/projects";

export interface Props {
  project: Project;
  featured?: boolean;
  showFullDescription?: boolean;
}

const { project, featured = false, showFullDescription = false } = Astro.props;

// Format date for display
function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
  });
}

// Get status badge class
function getStatusClass(status: string) {
  const classes = {
    completed: "status-completed",
    "in-progress": "status-in-progress",
    planned: "status-planned",
    archived: "status-archived",
  };
  return classes[status as keyof typeof classes] || "status-archived";
}

// Get difficulty badge class
function getDifficultyClass(difficulty: string) {
  const classes = {
    beginner: "difficulty-beginner",
    intermediate: "difficulty-intermediate",
    advanced: "difficulty-advanced",
  };
  return classes[difficulty as keyof typeof classes] || "difficulty-beginner";
}

// Get category icon
function getCategoryIcon(category: string) {
  const icons = {
    frontend: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>`,
    backend: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>`,
    fullstack: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-7H5a2 2 0 00-2 2v10a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2zM9 11l3 3 4-4"></path>`,
    mobile: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a1 1 0 001-1V4a1 1 0 00-1-1H8a1 1 0 00-1 1v16a1 1 0 001 1z"></path>`,
    api: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"></path>`,
    design: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM7 3H5a2 2 0 00-2 2v12a4 4 0 004 4h2a2 2 0 002-2V5a2 2 0 00-2-2z"></path>`,
  };
  return icons[category as keyof typeof icons] || icons["frontend"];
}
---

<article
  class={`card hover-lift group ${featured ? "ring-2 ring-primary-200 dark:ring-primary-800" : ""} animate-fade-in`}
>
  <!-- Project Image -->
  <div class="relative overflow-hidden rounded-t-xl">
    <img
      src={project.screenshot}
      alt={`Screenshot of ${project.title}`}
      class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
      decoding="async"
      onerror="this.src='/images/placeholder-project.png'"
    />

    <!-- Overlay with links on hover -->
    <div
      class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center space-x-3"
    >
      {
        project.liveUrl && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary btn-sm"
            aria-label={`View ${project.title} live demo`}
          >
            <svg
              class="w-4 h-4 mr-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
            Live Demo
          </a>
        )
      }

      {
        project.githubUrl && (
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary btn-sm"
            aria-label={`View ${project.title} source code`}
          >
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z"
                clip-rule="evenodd"
              />
            </svg>
            Code
          </a>
        )
      }
    </div>

    <!-- Featured badge -->
    {
      featured && (
        <div class="absolute top-3 left-3">
          <span class="inline-flex items-center px-2.5 py-1.5 rounded-full text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-800 dark:text-primary-300 shadow-sm">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            Featured
          </span>
        </div>
      )
    }
  </div>

  <!-- Card Content -->
  <div class="card-body">
    <!-- Header -->
    <div class="flex items-start justify-between mb-3">
      <div class="flex-1">
        <h3
          class="text-lg font-semibold text-gray-900 dark:text-white mb-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"
        >
          <a href={`/learnt/${project.slug}`} class="stretched-link">
            {project.title}
          </a>
        </h3>
        <div
          class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <Fragment set:html={getCategoryIcon(project.category)} />
          </svg>
          <span class="capitalize">{project.category}</span>
          <span>•</span>
          <time datetime={project.dateStarted}>
            {formatDate(project.dateStarted)}
          </time>
        </div>
      </div>
    </div>

    <!-- Description -->
    <p class="text-gray-600 dark:text-gray-300 text-sm mb-4 line-clamp-2">
      {showFullDescription ? project.longDescription : project.description}
    </p>

    <!-- Badges -->
    <div class="flex flex-wrap gap-2 mb-4">
      <span class={getStatusClass(project.status)}>
        {project.status.replace("-", " ")}
      </span>
      <span class={getDifficultyClass(project.difficulty)}>
        {project.difficulty}
      </span>
    </div>

    <!-- Technologies -->
    <div class="mb-4">
      <div class="flex flex-wrap gap-1">
        {
          project.technologies
            .slice(0, 4)
            .map((tech) => (
              <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                {tech}
              </span>
            ))
        }
        {
          project.technologies.length > 4 && (
            <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-200 dark:bg-gray-600 text-gray-600 dark:text-gray-400">
              +{project.technologies.length - 4} more
            </span>
          )
        }
      </div>
    </div>

    <!-- Progress indicator for in-progress projects -->
    {
      project.status === "in-progress" && (
        <div class="mb-4">
          <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400 mb-1">
            <span>Progress</span>
            <span>75%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
            <div
              class="bg-primary-600 h-2 rounded-full transition-all duration-300"
              style="width: 75%"
            />
          </div>
        </div>
      )
    }
  </div>

  <!-- Card Footer -->
  <div class="card-footer">
    <div class="flex items-center justify-between">
      <div
        class="flex items-center space-x-4 text-sm text-gray-500 dark:text-gray-400"
      >
        <div class="flex items-center">
          <svg
            class="w-4 h-4 mr-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            ></path>
          </svg>
          {project.features.length} features
        </div>
        <div class="flex items-center">
          <svg
            class="w-4 h-4 mr-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
          {project.learnings.length} learnings
        </div>
      </div>

      <a
        href={`/learnt/${project.slug}`}
        class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 text-sm font-medium transition-colors"
        aria-label={`Read more about ${project.title}`}
      >
        Learn more →
      </a>
    </div>
  </div>
</article>

<style>
  .stretched-link::after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    content: "";
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
