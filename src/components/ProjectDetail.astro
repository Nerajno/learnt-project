---
import type { Project } from "../data/projects";

const { project } = Astro.props as { project: Project };
---

<article class="prose dark:prose-invert max-w-3xl mx-auto">
  <header class="mb-6">
    <h1 class="text-3xl font-bold mb-2">{project.title}</h1>
    <p class="text-gray-600 dark:text-gray-400">{project.description}</p>
  </header>

  <img
    src={project.image || "/images/placeholder-project.png"}
    alt={project.title}
    class="w-full rounded-xl shadow mb-6"
    decoding="async"
  />

  <!-- Meta -->
  <section class="mb-6 space-y-2">
    <div><strong>Status:</strong> {project.status}</div>
    <div><strong>Difficulty:</strong> {project.difficulty}</div>
    <div><strong>Category:</strong> {project.category}</div>
    <div><strong>Technologies:</strong> {project.technologies.join(", ")}</div>
    {
      project.dateSunset && (
        <div>
          <strong>Sunset Date:</strong> {project.dateSunset}
        </div>
      )
    }
  </section>

  <!-- Learnings -->
  {
    project.learnings && (
      <section>
        <h2 class="text-xl font-semibold">What I Learned</h2>
        <ul class="list-disc pl-6">
          {project.learnings.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Links -->
  <footer class="mt-8 flex gap-4">
    {
      project.githubUrl && (
        <a href={project.githubUrl} target="_blank" class="btn btn-primary">
          GitHub
        </a>
      )
    }
    {
      project.liveUrl && (
        <a href={project.liveUrl} target="_blank" class="btn btn-secondary">
          Live Demo
        </a>
      )
    }
  </footer>
</article>
