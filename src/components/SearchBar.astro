---
import { STAGES, SORTS, type Stage } from '../lib/archive';
import { getUniqueCategories, getProjectYears } from '../data/projects';

export interface Props {
  counts: Record<Stage, number>;
  total: number;
}

const { counts, total } = Astro.props as Props;
const categories = getUniqueCategories();
const years = getProjectYears();
---

<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 mb-8 shadow-sm">
  <form id="archive-controls" method="get" action="/learnt" class="space-y-5">
    <div>
      <label for="archive-search" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
        Search projects
      </label>
      <input
        id="archive-search"
        name="q"
        type="search"
        class="input"
        placeholder="Search by title, description, technology, or tag..."
        autocomplete="off"
      />
    </div>

    <div>
      <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Stage</span>
      <div role="group" aria-label="Stage" class="flex flex-wrap gap-2">
        <button
          type="button"
          data-stage-filter=""
          aria-pressed="true"
          class="rounded-full border border-gray-300 dark:border-gray-600 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:border-primary-400 aria-pressed:bg-primary-700 aria-pressed:text-white aria-pressed:border-primary-700"
        >
          All <span class="ml-1 text-xs">{total}</span>
        </button>
        {STAGES.map((stage) => (
          <button
            type="button"
            data-stage-filter={stage.value}
            aria-pressed="false"
            class="rounded-full border border-gray-300 dark:border-gray-600 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:border-primary-400 aria-pressed:bg-primary-700 aria-pressed:text-white aria-pressed:border-primary-700"
          >
            {stage.label} <span class="ml-1 text-xs">{counts[stage.value]}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label for="archive-category" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          Category
        </label>
        <select id="archive-category" name="category" class="input">
          <option value="">All categories</option>
          {categories.map((category) => (
            <option value={category}>{category.charAt(0).toUpperCase() + category.slice(1)}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="archive-year" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          Year
        </label>
        <select id="archive-year" name="year" class="input">
          <option value="">All years</option>
          {years.map((year) => (
            <option value={String(year)}>{year}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="archive-sort" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          Sort
        </label>
        <select id="archive-sort" name="sort" class="input">
          {SORTS.map((sort) => (
            <option value={sort.value} selected={sort.value === 'newest'}>
              {sort.label}
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="flex justify-end">
      <button type="button" id="archive-clear" class="btn-secondary">Clear all</button>
    </div>
  </form>
</div>
