---
// #32 Garden ledger: one headstone on Home. Dates, lifespan, stage, epitaph,
// what it taught, and the way into the deep dive.
import StageChip from "../StageChip.astro";
import type { Project } from "../../data/projects";
import { monthYear } from "../../lib/home";
import { getLifespan } from "../../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const days = getLifespan(project);
const tags = project.tags.slice(0, 2);
const learnt = project.learnings.slice(0, 3);
---

<article class="headstone" data-slug={project.slug}>
  <p class="when">
    <span>
      <time datetime={project.born}>{monthYear(project.born)}</time>
      {project.died && <> → <time datetime={project.died}>{monthYear(project.died)}</time></>}
    </span>
    {days > 0 && <span>{days} day{days === 1 ? "" : "s"}</span>}
  </p>
  <h3><a href={`/learnt/${project.slug}`}>{project.title}</a></h3>
  <div class="chips">
    <StageChip stage={project.stage} cause={project.causeOfDeath} />
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  {project.epitaph ? (
    <p class="epitaph">“{project.epitaph}”</p>
  ) : (
    <p class="summary">{project.short ?? project.description}</p>
  )}
  {learnt.length > 0 && (
    <p class="learnt"><span>learnt:</span> {learnt.join(" · ")}</p>
  )}
  <p class="links">
    <a href={`/learnt/${project.slug}`}>deep dive <span aria-hidden="true">→</span><span class="sr-only"> into {project.title}</span></a>
    {project.githubUrl && (
      <a href={project.githubUrl} rel="noopener noreferrer">repo<span class="sr-only"> for {project.title}</span></a>
    )}
  </p>
</article>

<style>
  .headstone {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .when {
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin: 0;
    font-size: 1.125rem;
  }
  h3 a {
    color: var(--text-strong);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }
  .tag {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    background: var(--accent-2-soft);
    color: var(--accent-2);
  }
  .epitaph,
  .summary {
    margin: 0;
    color: var(--text-body);
  }
  .learnt {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border);
    font-size: 0.8125rem;
    color: var(--text-soft);
  }
  .learnt span {
    color: var(--text-muted);
  }
  .links {
    margin: auto 0 0;
    display: flex;
    gap: 1.25rem;
    font-size: 0.8125rem;
  }
  .links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
