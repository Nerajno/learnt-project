---
// #46: proof of work (VWC 3-1…3-6). Only what exists is shown; no invented metrics.
import type { Project } from "../../data/projects";
import { repoLabel } from "../../lib/images";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { proof = {} } = project;

const statements = [
  ["Outcome", project.outcome],
  ["Impact", project.impact],
  ["Epitaph", project.epitaph],
].filter((row): row is [string, string] => Boolean(row[1]));

const demo = project.liveUrl
  ? { label: "Live demo", href: project.liveUrl }
  : project.demoVideo
    ? { label: "Demo video", href: project.demoVideo }
    : undefined;

const strip = [
  ["Tests", proof.tests],
  ["Last deploy", proof.lastDeploy],
  ["Lighthouse", proof.lighthouse !== undefined ? String(proof.lighthouse) : undefined],
  ["CI", proof.ci === undefined ? undefined : proof.ci ? "passing" : "none"],
].filter((row): row is [string, string] => Boolean(row[1]));

const hasAnything = statements.length > 0 || project.githubUrl || demo || strip.length > 0;
---

{hasAnything && (
  <section class="pow" aria-labelledby="pow-h">
    <h2 id="pow-h">Proof of work</h2>
    {statements.length > 0 && (
      <dl class="statements">
        {statements.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    )}
    {(project.githubUrl || demo) && (
      <ul class="evidence">
        {project.githubUrl && (
          <li><a href={project.githubUrl} rel="noopener noreferrer">Repo: {repoLabel(project.githubUrl, project.slug)}</a></li>
        )}
        {demo && <li><a href={demo.href} rel="noopener noreferrer">{demo.label}</a></li>}
      </ul>
    )}
    {strip.length > 0 && (
      <dl class="strip">
        {strip.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    )}
  </section>
)}

<style>
  .pow {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  h2 {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
  }
  dl {
    margin: 0;
  }
  .statements div {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  dt {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  dd {
    margin: 0;
    color: var(--text-strong);
  }
  .evidence {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .evidence a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.5rem;
  }
  .strip div {
    background: var(--bg-alt);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.75rem;
  }
</style>
