---
// #46: related projects by shared technology, then prev/next.
import type { Project } from "../../data/projects";

interface Props {
  related: Project[];
  prev?: Project;
  next?: Project;
}

const { related, prev, next } = Astro.props;
---

{related.length > 0 && (
  <section aria-labelledby="soil-h">
    <h2 id="soil-h">Same soil</h2>
    <p class="hint">Other projects built with the same tools.</p>
    <ul class="soil" role="list">
      {related.map((r) => (
        <li>
          <a href={`/learnt/${r.slug}`}>{r.title}</a>
          <span>{r.short ?? r.description}</span>
        </li>
      ))}
    </ul>
  </section>
)}

{(prev || next) && (
  <nav class="pager" aria-label="Project navigation">
    {prev ? <a href={`/learnt/${prev.slug}`}><small>Previous</small>{prev.title}</a> : <span />}
    {next && <a class="next" href={`/learnt/${next.slug}`}><small>Next</small>{next.title}</a>}
  </nav>
)}

<style>
  h2 {
    margin: 0 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
  }
  .hint {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .soil {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .soil li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }
  .soil span {
    font-size: 0.8125rem;
    color: var(--text-soft);
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    min-height: 44px;
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
  small {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
</style>
