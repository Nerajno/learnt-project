---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@nerajno/dialects/tokens.css';
import themeInit from '@nerajno/dialects/theme-init.js?raw';
import '../styles/global.css';
import { site } from '../data/site';
import { publicFileExists } from '../lib/images';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  project?: any;
}

const { 
  title, 
  description = "A showcase of my learning journey through various development projects and technologies.",
  image = "/og-image.png",
  project
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Never point social metadata at a file that does not exist.
const ogImage = image && publicFileExists(image) ? image : '/images/placeholder.png';

const path = Astro.url.pathname;
const current =
  path === '/'
    ? 'Home'
    : path.startsWith('/learnt')
      ? 'Archive'
      : path.startsWith('/about')
        ? 'About'
        : path.startsWith('/contact')
          ? 'Contact'
          : '';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-surface="learn">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url)} />
    
    <!-- JSON-LD Structured Data for SEO (Project/Article) -->
    {Astro.props.project && (
      <script type="application/ld+json" is:inline>{JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CreativeWork',
        'name': Astro.props.project.title,
        'description': Astro.props.project.description,
        'image': new URL(ogImage, Astro.site).toString(),
        'url': new URL(Astro.url.pathname, Astro.site).toString(),
        'datePublished': Astro.props.project.born,
        'dateModified': Astro.props.project.died ?? Astro.props.project.born,
        'author': {
          '@type': 'Person',
          'name': 'Nerando Johnson'
        },
        'keywords': Astro.props.project.tags?.join(', ')
      })}</script>
    )}
    <!-- GA4 || Google Analytics -->
    <script
      is:inline
      type='text/partytown'
      src='https://www.googletagmanager.com/gtag/js?id=G-CXQYQ18LFT'></script>


      <script type='text/partytown'>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      // This is the important part
      gtag('consent', 'default', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted',
      });

      gtag('config', 'G-CXQYQ18LFT');
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme + surface, before first paint -->
    <script is:inline data-surface="learn" set:html={themeInit}></script>
  </head>
  
  <body class="min-h-screen transition-colors duration-300">
    <!-- Skip to main content for accessibility -->
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 btn-primary z-50">
      Skip to main content
    </a>
    
    <!-- Navigation -->
    <nav aria-label="Main" class="static md:sticky md:top-0 z-40 w-full border-b border-surface bg-surface">
      <div class="container-custom">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="font-mono text-xl font-semibold text-strong hover:text-accent-hover transition-colors">
            learnt<span class="text-accent">/</span>
          </a>

          <div class="hidden md:flex items-center gap-1">
            <a href="/" class:list={["nav-link", { active: current === "Home" }]} aria-current={current === "Home" ? "page" : undefined}>Home</a>
            <a href="/learnt" class:list={["nav-link", { active: current === "Archive" }]} aria-current={current === "Archive" ? "page" : undefined}>Archive</a>
            <a href="/about" class:list={["nav-link", { active: current === "About" }]} aria-current={current === "About" ? "page" : undefined}>About</a>
            <a href="/contact" class:list={["nav-link", { active: current === "Contact" }]} aria-current={current === "Contact" ? "page" : undefined}>Contact</a>
            <a href={site.portfolio} class="nav-link">developingdvlpr.com ↗</a>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="theme-toggle"
              type="button"
              class="inline-flex items-center justify-center w-[44px] h-[44px] rounded-lg border border-surface-strong bg-surface-card text-body hover:bg-surface-alt transition-colors"
              aria-label="Switch to dark mode"
              aria-pressed="false"
            >
              <svg id="sun-icon" class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
              </svg>
              <svg id="moon-icon" class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20">
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
              </svg>
            </button>

            <button
              id="mobile-menu-toggle"
              type="button"
              class="md:hidden inline-flex items-center justify-center w-[44px] h-[44px] rounded-lg border border-surface-strong bg-surface-card text-body hover:bg-surface-alt transition-colors"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-menu" class="hidden md:hidden border-t border-surface bg-surface">
        <div class="container-custom py-3 space-y-1">
          <a href="/" class:list={["mobile-nav-link", { active: current === "Home" }]} aria-current={current === "Home" ? "page" : undefined}>Home</a>
          <a href="/learnt" class:list={["mobile-nav-link", { active: current === "Archive" }]} aria-current={current === "Archive" ? "page" : undefined}>Archive</a>
          <a href="/about" class:list={["mobile-nav-link", { active: current === "About" }]} aria-current={current === "About" ? "page" : undefined}>About</a>
          <a href="/contact" class:list={["mobile-nav-link", { active: current === "Contact" }]} aria-current={current === "Contact" ? "page" : undefined}>Contact</a>
          <a href={site.portfolio} class="mobile-nav-link">developingdvlpr.com ↗</a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main id="main" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-surface bg-surface-alt">
      <div class="container-custom py-12">
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
          <div>
            <a href="/" class="font-mono text-xl font-semibold text-strong hover:text-accent-hover transition-colors">
              learnt<span class="text-accent">/</span>
            </a>
            <p class="mt-3 text-body text-sm">Progress over perfection.</p>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
            <a href={site.blog} class="footer-link">Blog</a>
            <a href={site.garden} class="footer-link">Garden</a>
            <a href={site.social.github.url} class="social-link" aria-label="GitHub">GitHub</a>
            <a href={site.social.linkedin.url} class="social-link" aria-label="LinkedIn">LinkedIn</a>
            <a href={site.social.x.url} class="social-link" aria-label="X (Twitter)">X</a>
          </div>
        </div>

        <div class="mt-8 border-t border-surface pt-6 text-sm text-soft">
          © {new Date().getFullYear()} <a href={site.portfolio} class="footer-link">{site.name}</a>
        </div>
      </div>
    </footer>

    <!-- Scripts -->
    <script>
      // Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;

      const setThemeButton = () => {
        const dark = html.classList.contains('dark');
        themeToggle?.setAttribute('aria-pressed', String(dark));
        themeToggle?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      };

      setThemeButton();
      themeToggle?.addEventListener('click', () => {
        const isDark = html.classList.contains('dark');

        html.classList.toggle('dark', !isDark);
        html.classList.toggle('light', isDark);
        html.setAttribute('data-theme', isDark ? 'light' : 'dark');
        localStorage.setItem('theme', isDark ? 'light' : 'dark');
        setThemeButton();
      });

      // Mobile menu
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');

      const setMenu = (open: boolean) => {
        if (!mobileMenu || !mobileMenuToggle) return;
        mobileMenu.classList.toggle('hidden', !open);
        mobileMenuToggle.setAttribute('aria-expanded', String(open));
        mobileMenuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        if (open) mobileMenu.querySelector('a')?.focus();
      };

      mobileMenuToggle?.addEventListener('click', () => {
        setMenu(mobileMenu?.classList.contains('hidden') ?? false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
          setMenu(false);
          mobileMenuToggle?.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (
          !mobileMenuToggle?.contains(event.target as Node) &&
          !mobileMenu?.contains(event.target as Node)
        ) {
          setMenu(false);
        }
      });

      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });
    </script>

    <style>
      .nav-link {
        @apply inline-flex items-center min-h-[44px] px-3 rounded-md text-sm font-medium text-body hover:text-accent hover:bg-surface-alt transition-colors;
      }

      .nav-link.active {
        @apply text-accent bg-surface-alt;
      }

      .mobile-nav-link {
        @apply flex items-center min-h-[44px] px-3 rounded-md text-base font-medium text-body hover:text-accent hover:bg-surface-alt transition-colors;
      }

      .mobile-nav-link.active {
        @apply text-accent bg-surface-alt;
      }

      .footer-link {
        @apply inline-flex items-center justify-center min-h-[44px] min-w-[44px] text-soft hover:text-accent-hover underline underline-offset-2 transition-colors;
      }

      .social-link {
        @apply inline-flex items-center justify-center min-h-[44px] min-w-[44px] text-soft hover:text-accent-hover underline underline-offset-2 transition-colors;
      }
    </style>
  </body>
</html>