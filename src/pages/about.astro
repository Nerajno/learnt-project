---
// #85: About on the dialects learn surface. Copy slots are filled by #31.
import Layout from "../layouts/Layout.astro";
import StageChip from "../components/StageChip.astro";
import StageLegend from "../components/StageLegend.astro";
import { getProjectsByStage } from "../data/projects";
import { site } from "../data/site";

const activeProjects = [...getProjectsByStage("seed"), ...getProjectsByStage("sprout")];

// #31: the proof-of-work standard every headstone follows (from the VWC checklist).
const STANDARD = [
  "The problem it solved",
  "The repo",
  "A working demo",
  "Screenshots",
  "What was hard",
  "What I learned",
  "How long it lived",
  "What came before and after it",
];

const ELSEWHERE = [
  { name: "Portfolio", href: `${site.portfolio}portfolio`, blurb: "The curated work: featured projects and MVPs." },
  { name: "Blog", href: site.blog, blurb: "Articles, written in public." },
  { name: "Garden", href: site.garden, blurb: "The Rolodex of terms I’ve learnt." },
  { name: "Tracker", href: "https://isnerandodoneyet.com", blurb: "Is Nerando done yet? Project status at a glance." },
];
---

<Layout title="About">
  <div class="about container-custom">
    <header class="intro">
      <h1 class="text-strong">Killed by Google, but every headstone says what it taught me.</h1>
      <p class="lead text-strong">
        I’m Nerando Johnson, a front-end engineer in Atlanta working in Vue 3, TypeScript and Nuxt.
        This is the full archive: every project I’ve started, shipped, or let go, with what each one taught me.
        The curated work lives at developingdvlpr.com.
      </p>
      <p class="text-body">
        I teach, and teachers keep receipts. I got here as a hobbyist, a mentee, a freeCodeCamp learner,
        a bootcamp graduate and a consultant, and I learn in public. The projects that taught me the most
        mostly aren’t on the polished portfolio, so they live here, in the spirit of
        <a class="text-accent underline" href="https://killedbygoogle.com/" target="_blank" rel="noopener noreferrer">Killed by Google<span class="sr-only"> (opens in new tab)</span></a>.
      </p>
      <p class="text-body">
        Great software is as much about people as code. I learnt how to use Stack Overflow the hard way —
        by asking a question first.
      </p>
      <p>
        <a
          href="https://developingdvlpr.com"
          class="btn btn-secondary"
          aria-label="Curated work lives here: open the main portfolio (developingdvlpr.com)"
        >
          Curated work lives here <span aria-hidden="true">↗</span>
        </a>
      </p>
    </header>

    <section aria-labelledby="standard-h">
      <h2 id="standard-h" class="text-2xl font-bold text-strong">The proof-of-work standard</h2>
      <p class="text-body">
        Every headstone answers the same eight questions, adapted from the Vets Who Code portfolio checklist:
      </p>
      <ol class="standard text-body" role="list" data-testid="pow-standard">
        {STANDARD.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section aria-labelledby="stages-h">
      <h2 id="stages-h" class="text-2xl font-bold text-strong">Why not seedling, budding, evergreen?</h2>
      <p class="text-body">
        Digital gardens grade notes by how finished they are. Projects are different: they get planned,
        built, shipped, and sometimes ended on purpose. So the stages here describe a project’s life,
        and composting counts as a result, not a failure. A longer write-up is coming on the
        <a class="text-accent underline" href={site.blog}>blog</a>.
      </p>
    </section>

    <StageLegend />

    <section aria-labelledby="elsewhere-h">
      <h2 id="elsewhere-h" class="text-2xl font-bold text-strong">Where everything else lives</h2>
      <ul class="ledger" role="list" data-testid="elsewhere">
        {ELSEWHERE.map((place) => (
          <li class="row bg-surface-card border border-surface shadow-card">
            <div class="row-body">
              <a class="row-title text-strong" href={place.href}>{place.name}</a>
              <p class="text-soft">{place.blurb}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="text-soft social">
        Also on <a class="underline" href={site.social.github.url}>GitHub</a>,
        <a class="underline" href={site.social.linkedin.url}>LinkedIn</a> and
        <a class="underline" href={site.social.x.url}>Twitter/X</a>.
      </p>
    </section>

    <section class="building" aria-labelledby="building-h">
      <h2 id="building-h" class="text-2xl font-bold text-strong">Still alive, so not composted yet</h2>
      {activeProjects.length > 0 ? (
        <>
          <p class="text-soft">Seeds and sprouts, generated from the archive:</p>
          <ul class="ledger" role="list" data-testid="about-ledger">
            {activeProjects.map((project) => (
              <li class="row bg-surface-card border border-surface shadow-card">
                <StageChip stage={project.stage} />
                <div class="row-body">
                  <a class="row-title text-strong" href={`/learnt/${project.slug}`}>{project.title}</a>
                  <p class="text-soft">{project.description}</p>
                </div>
                {project.liveUrl && (
                  <a
                    class="row-live text-accent"
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.title} live site (opens in new tab)`}
                  >
                    live site <span aria-hidden="true">↗</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p class="text-soft">Nothing in the ground right now.</p>
      )}
    </section>
  </div>
</Layout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 2rem 4rem;
    max-width: 52rem;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
  }
  h2 {
    margin: 0 0 0.5rem;
  }
  p {
    margin: 0;
  }
  .lead {
    font-size: 1.125rem;
  }
  .intro .btn {
    margin-top: 0.5rem;
  }
  .standard {
    margin: 0.75rem 0 0;
    padding-left: 1.5rem;
    list-style: decimal;
    display: grid;
    gap: 0.25rem;
  }
  .social {
    margin-top: 0.75rem;
  }
  .ledger {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.75rem 1rem;
    align-items: start;
    justify-items: start;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .row:hover {
    transform: translateY(-2px);
  }
  .row-live {
    justify-self: end;
  }
  @media (max-width: 640px) {
    .row-live {
      justify-self: start;
    }
  }
  .row-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .row-title {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .row-live {
    white-space: nowrap;
    font-size: 0.875rem;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row {
      transition: none;
    }
    .row:hover {
      transform: none;
    }
  }
</style>
