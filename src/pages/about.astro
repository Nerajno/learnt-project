---
import Layout from "../layouts/Layout.astro";
import { getProjectsByPhase } from "../data/projects";

const activeProjects = getProjectsByPhase("active");
---

<Layout title="About">
  <section class="max-w-3xl mx-auto px-4 py-12 prose dark:prose-invert">
    <h1>About</h1>
    <p>
      This site is a collection of projects I’ve built, experimented with, or sunsetted along the way.
      It’s inspired by <em>Killed by Google</em>, but focused on my own learning journey.
    </p>
    <p>
      Each project taught me something valuable — whether it’s mastering a new technology,
      understanding best practices, or simply knowing when to let go.
    </p>
    <p>
      My goal is to continuously learn, share and track my progress, and document my learning path.
    </p>

    {activeProjects.length > 0 && (
      <>
        <h2>Currently building</h2>
        <p>Still alive, so not in the graveyard yet:</p>
        <ul>
          {activeProjects.map((project) => (
            <li>
              <a href={`/learnt/${project.slug}`}>{project.title}</a> — {project.description}
              {project.liveUrl && (
                <>
                  {" "}(<a href={project.liveUrl} target="_blank" rel="noopener noreferrer">live site</a>)
                </>
              )}
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
</Layout>
