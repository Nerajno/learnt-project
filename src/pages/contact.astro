---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const { github, linkedin, x } = site.social;

const contactLinks = [
  { platform: "Portfolio", href: site.portfolio, label: new URL(site.portfolio).host },
  { platform: "GitHub", href: github.url, label: `@${github.handle}` },
  { platform: "LinkedIn", href: linkedin.url, label: `linkedin.com/in/${linkedin.handle}` },
  { platform: "X", href: x.url, label: `@${x.handle}` },
];

const topics = [
  "A project in the archive",
  "Collaboration",
  "Speaking or workshop",
  "Just saying hello",
];

const seoDescription =
  "Built something similar or spotted a better fix? Open to questions and collaboration.";

const label = "block text-sm font-medium text-strong mb-1";
const field =
  "block w-full min-h-[48px] px-3 py-2 rounded-lg border border-surface-strong bg-surface-card text-body " +
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const hint = "mt-1 text-xs text-soft";
---

<Layout title="Contact" description={seoDescription}>
  <section class="container-custom py-12">
    <div class="grid gap-10 lg:grid-cols-[2fr_3fr]">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold mb-4">
          Built something similar? Spotted a better fix?
        </h1>
        <p class="text-lg text-body mb-8">Open to questions and collaboration.</p>

        <ul class="space-y-3" aria-label="Elsewhere">
          {contactLinks.map((link) => (
            <li>
              <a href={link.href} rel="noopener noreferrer" class="inline-flex min-h-[44px] items-baseline gap-2">
                <span class="font-medium text-strong">{link.platform}</span>
                <span class="text-sm text-soft">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <form
        id="contact-form"
        name="contact"
        method="POST"
        action="/contact/thanks"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-5 p-6 rounded-lg border border-surface bg-surface-alt"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden" aria-hidden="true">
          <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <label for="name" class={label}>Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-hint" class={field} />
            <p id="name-hint" class={hint}>Required.</p>
          </div>
          <div>
            <label for="email" class={label}>Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-hint" class={field} />
            <p id="email-hint" class={hint}>Required. I'll reply here.</p>
          </div>
        </div>

        <div>
          <label for="topic" class={label}>What's it about?</label>
          <select id="topic" name="topic" autocomplete="off" class={field}>
            {topics.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>

        <div>
          <label for="project" class={label}>Which project? (optional)</label>
          <input id="project" name="project" type="text" autocomplete="off" aria-describedby="project-hint" class={field} />
          <p id="project-hint" class={hint}>The project name or its archive URL.</p>
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="6" required aria-describedby="message-hint" class={field}></textarea>
          <p id="message-hint" class={hint}>Required.</p>
        </div>

        <button type="submit" class="btn-primary min-h-[48px] px-6">Send message</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  // /contact?project=<slug> prefills the project field (linked from detail pages).
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const project = new URLSearchParams(window.location.search).get("project");
  if (form && project) {
    (form.elements.namedItem("project") as HTMLInputElement).value = project.slice(0, 200);
    (form.elements.namedItem("topic") as HTMLSelectElement).value = "A project in the archive";
  }
</script>
