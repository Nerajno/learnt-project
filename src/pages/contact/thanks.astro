---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Message sent" description="Thanks for getting in touch.">
  <section class="container-custom py-16 text-center max-w-2xl mx-auto">
    <h1 id="thanks-heading" tabindex="-1" class="text-3xl md:text-4xl font-bold mb-4">
      Thanks. Your message is on its way.
    </h1>
    <p class="text-lg text-body mb-8">I read everything that comes in and reply by email.</p>
    <a href="/learnt" class="btn-primary min-h-[48px] px-6">Back to the archive</a>
  </section>
</Layout>

<script>
  // Move focus to the confirmation so screen readers announce it after the redirect.
  document.getElementById("thanks-heading")?.focus();
</script>
