---
// #45 Home: the Garden ledger front page. Everything comes from the collection.
import Layout from '../layouts/Layout.astro';
import StageChip from '../components/StageChip.astro';
import StageLegend from '../components/StageLegend.astro';
import { projects, getProjectBySlug, getUniqueTechnologies } from '../data/projects';
import { homeJsonLd } from '../lib/jsonld';
import { getByYear, getStats } from '../lib/projects';
import { compostLine, getRecentlyComposted, getStillGrowing, monthYear, toYearBars } from '../lib/home';
import { STAGES } from '../lib/stages';

const stats = getStats();
const firstYear = Math.min(...projects.map((p) => Number(p.born.slice(0, 4))));
const composted = getRecentlyComposted();
const growing = getStillGrowing();
const trail = toYearBars(getByYear());
const busiest = Math.max(1, ...trail.map((y) => y.total));
// Bar segments run in lifecycle order: shipped and composted first, then what's still alive.
const segmentOrder = ['shipped', 'composted', 'sprout', 'seed'] as const;
const stageName = Object.fromEntries(STAGES.map((s) => [s.value, s.label.toLowerCase()]));
---

<Layout title="Learnt | Proof-of-work archive" jsonLd={homeJsonLd(new URL('/', Astro.site))}>
  <div class="ledger container-custom">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">The proof-of-work archive · {firstYear} → now</p>
        <h1 id="home-title">Every project I've shipped, sunset or buried — and what each one taught me.</h1>
        <p class="lede">
          A ledger of the things I built to learn: when each one stopped, why it stopped, and the proof
          that it existed. Progress over perfection, on the record.
        </p>
        <div class="ctas">
          <a href="/learnt" class="btn-primary min-h-[44px]">Browse the archive</a>
          <a href="#stages" class="btn-secondary min-h-[44px]">How the stages work</a>
        </div>
      </div>

      <dl class="stats">
        <div><dt>projects logged</dt><dd data-stat="total">{stats.total}</dd></div>
        <div><dt>shipped</dt><dd data-stat="shipped">{stats.byStage.shipped}</dd></div>
        <div><dt>still growing</dt><dd data-stat="growing">{stats.byStage.seed + stats.byStage.sprout}</dd></div>
        <div><dt>technologies touched</dt><dd data-stat="technologies">{getUniqueTechnologies().length}</dd></div>
      </dl>
    </section>

    <div id="stages">
      <StageLegend />
    </div>

    <section data-section="composted" aria-labelledby="composted-h">
      <h2 id="composted-h">Recently composted</h2>
      {composted.length === 0 ? (
        <p class="empty">Nothing composted yet. Projects land here when they end.</p>
      ) : (
        <div class="compost-grid">
          {composted.map((p) => {
            const successor = p.supersededBy ? getProjectBySlug(p.supersededBy) : undefined;
            return (
              <article class="compost">
                <StageChip stage={p.stage} cause={p.causeOfDeath} />
                <h3><a href={`/learnt/${p.slug}`}>{p.title}</a></h3>
                <p class="compost-line">{compostLine(p)}</p>
                {successor && (
                  <p class="successor">
                    Superseded by <a href={`/learnt/${successor.slug}`}>{successor.title}</a>
                  </p>
                )}
              </article>
            );
          })}
        </div>
      )}
    </section>

    <section data-section="growing" aria-labelledby="growing-h">
      <h2 id="growing-h">Still growing</h2>
      {growing.length === 0 ? (
        <p class="empty">Nothing in progress right now.</p>
      ) : (
        <ul class="rows">
          {growing.map((p) => (
            <li>
              <StageChip stage={p.stage} />
              <a href={`/learnt/${p.slug}`} class="row-title">{p.title}</a>
              <span class="row-stack">{p.technologies.slice(0, 3).join(', ')}</span>
              <time datetime={p.born}>since {monthYear(p.born)}</time>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section data-section="trail" aria-labelledby="trail-h">
      <h2 id="trail-h">The trail, by year</h2>
      <p class="hint">Each bar is split by how that year's projects ended up.</p>
      <ol class="trail">
        {trail.map((y) => (
          <li>
            <a href={y.href}>
              <span class="trail-year">{y.year}</span>
              <span class="trail-bar" aria-hidden="true">
                {segmentOrder
                  .filter((stage) => y.byStage[stage] > 0)
                  .map((stage) => (
                    <span
                      class={`seg seg-${stage}`}
                      style={`width:${(y.byStage[stage] / busiest) * 100}%`}
                    />
                  ))}
              </span>
              <span class="trail-count">
                {y.total} project{y.total === 1 ? '' : 's'}
                <span class="sr-only">
                  :{' '}
                  {segmentOrder
                    .filter((stage) => y.byStage[stage] > 0)
                    .map((stage) => `${y.byStage[stage]} ${stageName[stage]}`)
                    .join(', ')}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="key" aria-hidden="true">
        {segmentOrder.map((stage) => (
          <span><i class={`seg seg-${stage}`} />{stageName[stage]}</span>
        ))}
      </p>
    </section>
  </div>
</Layout>

<style>
  .ledger {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding-block: 3rem 4rem;
  }

  h2 {
    margin: 0 0 1.25rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  /* hero: copy left, ruled 2x2 ledger of totals right */
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
    align-items: flex-end;
  }
  .hero-copy {
    flex: 999 1 30rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 22ch;
  }
  .lede {
    margin: 0;
    max-width: 62ch;
    color: var(--text-soft);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .stats {
    flex: 1 1 17rem;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .stats div {
    background: var(--bg-card);
    padding: 0.875rem 1rem;
  }
  .stats dt {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .stats dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }

  /* recently composted */
  .compost-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .compost {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .compost h3 {
    margin: 0.25rem 0 0;
    font-size: 1rem;
  }
  .compost h3 a {
    color: var(--text-strong);
  }
  .compost-line,
  .successor {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-soft);
  }

  /* still growing: ruled rows */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }
  .rows li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 14rem) auto;
    gap: 0.5rem 1rem;
    align-items: center;
    padding: 0.875rem 0.25rem;
    border-bottom: 1px solid var(--border);
  }
  .row-title {
    font-weight: 600;
    color: var(--text-strong);
  }
  .row-stack,
  .rows time {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* the trail: one stacked bar per year */
  .hint {
    margin: -0.75rem 0 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .trail {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .trail a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 7.5rem;
    gap: 1rem;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    border-radius: var(--radius-sm);
    color: var(--text-body);
  }
  .trail a:hover {
    background: var(--bg-alt);
    text-decoration: none;
  }
  .trail-year {
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .trail-bar {
    display: flex;
    height: 0.625rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--bg-alt);
  }
  .trail-count {
    font-size: 0.8125rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .seg {
    display: inline-block;
    height: 100%;
  }
  .seg-shipped { background: var(--success); }
  .seg-composted { background: var(--warning); }
  /* Striped = unfinished; keeps sprout distinct from composted's amber by pattern, not hue alone. */
  .seg-sprout {
    background: repeating-linear-gradient(
      -45deg,
      var(--accent) 0 3px,
      transparent 3px 6px
    );
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .seg-seed { background: var(--border-strong); }

  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1rem 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .key span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .key i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 2px;
  }

  .empty {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .rows li {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .row-stack,
    .rows time {
      grid-column: 2;
    }
    .trail a {
      grid-template-columns: 3rem minmax(0, 1fr) 6.5rem;
      gap: 0.75rem;
    }
  }
</style>
