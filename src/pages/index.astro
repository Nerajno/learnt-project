---
import Layout from '../layouts/Layout.astro';
import ProjectList from '../components/ProjectList.astro';
import { getFeaturedProjects } from '../data/projects';
import { homeJsonLd } from '../lib/jsonld';
import StageLegend from '../components/StageLegend.astro';
import { getStats } from '../lib/projects';

const featuredProjects = getFeaturedProjects();
const stats = getStats();
---

<Layout title="Welcome | Learnt" jsonLd={homeJsonLd(new URL('/', Astro.site))}>
  <section class="py-16">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          My Learning Journey
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
          Exploring new technologies, building projects, and documenting my journey as a developer.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/learnt" class="btn btn-primary">
            View All Projects
          </a>
          <a href="/about" class="btn btn-secondary">
            About Me
          </a>
        </div>
        <p class="mt-6 text-sm text-gray-600 dark:text-gray-300">
          {stats.total} projects · {stats.byStage.shipped} shipped · {stats.byStage.composted} composted
        </p>
      </div>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="py-12 bg-gray-50 dark:bg-gray-800/50">
      <div class="container-custom">
        <h2 class="text-2xl font-bold mb-8 text-center">Featured Projects</h2>
        <ProjectList projects={featuredProjects} />
        <div class="text-center mt-8">
          <a href="/learnt" class="btn btn-ghost">
            View All Projects →
          </a>
        </div>
      </div>
    </section>
  )}

  <div class="container-custom py-12">
    <StageLegend />
  </div>

  <section class="py-16">
    <div class="container-custom text-center">
      <h2 class="text-2xl font-bold mb-6">What I'm Learning</h2>
      <div class="max-w-3xl mx-auto">
        <p class="text-gray-600 dark:text-gray-300 mb-8">
          I'm constantly exploring new technologies and documenting my learning process. 
          Check out my latest projects and tutorials to see what I've been working on.
        </p>
        <a href="/about" class="btn btn-primary">
          Learn More About Me
        </a>
      </div>
    </div>
  </section>
</Layout>

