---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import ProjectList from "../components/ProjectList.astro";
import CourseworkList from "../components/CourseworkList.astro";
import ArchiveTimeline from "../components/ArchiveTimeline.astro";
import { getCardProjects, getCourseworkProjects } from "../data/projects";
import { countByStage, toArchiveItem } from "../lib/archive";
import { getStats } from "../lib/projects";
import { getTimeline } from "../lib/timeline";

const archiveProjects = getCardProjects();
const archiveItems = archiveProjects.map(toArchiveItem);
const courseworkProjects = getCourseworkProjects();
const counts = countByStage(archiveItems);
// Same set as the card grid and its filter counts; coursework is listed separately.
const stats = getStats(archiveProjects);
---

<Layout
  title="Learnt Projects | My Learning Journey"
  description="Explore all my learning projects, experiments, and archived work. A comprehensive collection documenting my development journey."
>
  <!-- Hero Section -->
  <section class="bg-surface-alt border-b border-surface">
    <div class="container-custom py-12 md:py-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
          Learnt Projects
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
          A comprehensive archive of projects I've built, learned from, and sunset along the way.
          Each one represents a step in my learning journey.
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
          <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
            <div class="text-3xl font-bold text-accent" data-stat="total">
              {stats.total}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">All Projects</div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
            <div class="text-3xl font-bold text-blue-600 dark:text-blue-400" data-stat="growing">
              {stats.byStage.seed + stats.byStage.sprout}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Growing</div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
            <div class="text-3xl font-bold text-green-600 dark:text-green-400" data-stat="shipped">
              {stats.byStage.shipped}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Shipped</div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
            <div class="text-3xl font-bold text-purple-600 dark:text-purple-400" data-stat="composted">
              {stats.byStage.composted}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Composted</div>
          </div>
        </div>

        <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
          {archiveItems.length} archive cards · {courseworkProjects.length} coursework
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="container-custom py-12">
    <SearchBar counts={counts} total={archiveItems.length} />

    <p id="archive-result" class="text-sm text-gray-600 dark:text-gray-400 mb-6" aria-live="polite">
      Showing <span id="archive-count">{archiveItems.length}</span> of {archiveItems.length} projects
    </p>

    <div id="archive-empty" hidden class="text-center py-12">
      <svg class="w-16 h-16 mx-auto text-gray-400 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
        No projects found
      </h3>
      <p class="text-gray-600 dark:text-gray-400 mb-6">
        Try adjusting your filters or search terms
      </p>
      <button type="button" id="archive-empty-clear" class="btn-primary">
        Clear all filters
      </button>
    </div>

    <ProjectList id="project-list" projects={archiveProjects} />
    <ArchiveTimeline years={getTimeline(archiveProjects)} />

    <CourseworkList projects={courseworkProjects} />
  </section>

  <!-- Additional Info Section -->
  <section class="bg-gray-50 dark:bg-gray-800/50 border-t border-gray-200 dark:border-gray-700 py-12">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
          About This Archive
        </h2>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          This collection represents my learning journey as a developer. Every project here—whether
          successful, experimental, or sunset—taught me something valuable. I believe in documenting
          both wins and learning experiences, because that's how we grow.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about" class="btn-secondary">
            Learn More About Me
          </a>
          <a href="https://github.com/Nerajno" target="_blank" rel="noopener noreferrer" class="btn-ghost">
            View on GitHub →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/archive-filter';
</script>
