---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import ProjectList from "../components/ProjectList.astro";
import {
  getAllProjects,
  getProjectStats,
  getProjectsByYear,
  getProjectYears
} from "../data/projects";

const url = Astro.url;
const searchParams = url.searchParams;

// Get all filter parameters
const filters = {
  search: searchParams.get("search") || "",
  category: searchParams.get("category") || "",
  status: searchParams.get("status") || "",
  difficulty: searchParams.get("difficulty") || "",
  technology: searchParams.get("technology") || "",
  phase: searchParams.get("phase") || "",
  year: searchParams.get("year") || "",
  tag: searchParams.get("tag") || "",
};

// Get all projects and apply filters
const allProjects = getAllProjects();
let filteredProjects = allProjects;

// Apply search filter
if (filters.search) {
  const searchLower = filters.search.toLowerCase();
  filteredProjects = filteredProjects.filter(project =>
    project.title.toLowerCase().includes(searchLower) ||
    project.description.toLowerCase().includes(searchLower) ||
    project.longDescription.toLowerCase().includes(searchLower) ||
    project.technologies.some(tech => tech.toLowerCase().includes(searchLower)) ||
    project.tags.some(tag => tag.toLowerCase().includes(searchLower))
  );
}

// Apply category filter
if (filters.category) {
  filteredProjects = filteredProjects.filter(
    project => project.category === filters.category
  );
}

// Apply status filter
if (filters.status) {
  filteredProjects = filteredProjects.filter(
    project => project.status === filters.status
  );
}

// Apply difficulty filter
if (filters.difficulty) {
  filteredProjects = filteredProjects.filter(
    project => project.difficulty === filters.difficulty
  );
}

// Apply technology filter
if (filters.technology) {
  filteredProjects = filteredProjects.filter(project =>
    project.technologies.some(tech =>
      tech.toLowerCase().includes(filters.technology.toLowerCase())
    )
  );
}

// Apply phase filter
if (filters.phase) {
  filteredProjects = filteredProjects.filter(
    project => project.phase === filters.phase
  );
}

// Apply year filter
if (filters.year) {
  const year = parseInt(filters.year);
  filteredProjects = filteredProjects.filter(project => {
    const projectYear = new Date(project.dateCreated || project.dateStarted).getFullYear();
    return projectYear === year;
  });
}

// Apply tag filter
if (filters.tag) {
  filteredProjects = filteredProjects.filter(project =>
    project.tags.some(tag =>
      tag.toLowerCase() === filters.tag.toLowerCase()
    )
  );
}

// Sort projects by date (newest first)
filteredProjects.sort((a, b) => {
  const dateA = new Date(a.dateCreated || a.dateStarted).getTime();
  const dateB = new Date(b.dateCreated || b.dateStarted).getTime();
  return dateB - dateA;
});

// Get stats for display
const stats = getProjectStats();
const years = getProjectYears();

// Check if filters are active
const hasActiveFilters = Object.values(filters).some(value => value !== "");
---

<Layout
  title="Learnt Projects | My Learning Journey"
  description="Explore all my learning projects, experiments, and archived work. A comprehensive collection documenting my development journey."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-50 to-purple-50 dark:from-gray-900 dark:to-gray-800 border-b border-gray-200 dark:border-gray-700">
    <div class="container-custom py-12 md:py-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
          Learnt Projects
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
          A comprehensive archive of projects I've built, learned from, and sunset along the way.
          Each one represents a step in my learning journey.
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
          <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
            <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">
              {stats.total}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Total Projects</div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
            <div class="text-3xl font-bold text-green-600 dark:text-green-400">
              {stats.completed}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Completed</div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
            <div class="text-3xl font-bold text-blue-600 dark:text-blue-400">
              {stats.active}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Active</div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
            <div class="text-3xl font-bold text-purple-600 dark:text-purple-400">
              {stats.technologies}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Technologies</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="container-custom py-12">
    <!-- Search & Filters -->
    <SearchBar />

    <!-- Filter Summary & Results Count -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
          {filteredProjects.length} {filteredProjects.length === 1 ? 'Project' : 'Projects'}
        </h2>
        {hasActiveFilters && (
          <a
            href="/learnt"
            class="text-sm text-primary-600 dark:text-primary-400 hover:underline flex items-center gap-1"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Clear all filters
          </a>
        )}
      </div>

      <!-- Sort Options (Future Enhancement) -->
      <div class="text-sm text-gray-600 dark:text-gray-400">
        Sorted by: Newest first
      </div>
    </div>

    <!-- Active Filters Display -->
    {hasActiveFilters && (
      <div class="mb-6 flex flex-wrap gap-2">
        {filters.search && (
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-primary-100 dark:bg-primary-900/30 text-primary-800 dark:text-primary-300">
            Search: "{filters.search}"
            <a href={`/learnt?${new URLSearchParams({...filters, search: ''}).toString()}`} class="hover:text-primary-600">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </a>
          </span>
        )}
        {filters.category && (
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300">
            Category: {filters.category}
            <a href={`/learnt?${new URLSearchParams({...filters, category: ''}).toString()}`} class="hover:text-blue-600">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </a>
          </span>
        )}
        {filters.status && (
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
            Status: {filters.status}
            <a href={`/learnt?${new URLSearchParams({...filters, status: ''}).toString()}`} class="hover:text-green-600">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </a>
          </span>
        )}
        {filters.phase && (
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-purple-100 dark:bg-purple-900/30 text-purple-800 dark:text-purple-300">
            Phase: {filters.phase}
            <a href={`/learnt?${new URLSearchParams({...filters, phase: ''}).toString()}`} class="hover:text-purple-600">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </a>
          </span>
        )}
        {filters.difficulty && (
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300">
            Difficulty: {filters.difficulty}
            <a href={`/learnt?${new URLSearchParams({...filters, difficulty: ''}).toString()}`} class="hover:text-orange-600">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </a>
          </span>
        )}
        {filters.year && (
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-indigo-100 dark:bg-indigo-900/30 text-indigo-800 dark:text-indigo-300">
            Year: {filters.year}
            <a href={`/learnt?${new URLSearchParams({...filters, year: ''}).toString()}`} class="hover:text-indigo-600">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </a>
          </span>
        )}
        {filters.technology && (
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-pink-100 dark:bg-pink-900/30 text-pink-800 dark:text-pink-300">
            Tech: {filters.technology}
            <a href={`/learnt?${new URLSearchParams({...filters, technology: ''}).toString()}`} class="hover:text-pink-600">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </a>
          </span>
        )}
        {filters.tag && (
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-teal-100 dark:bg-teal-900/30 text-teal-800 dark:text-teal-300">
            Tag: {filters.tag}
            <a href={`/learnt?${new URLSearchParams({...filters, tag: ''}).toString()}`} class="hover:text-teal-600">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </a>
          </span>
        )}
      </div>
    )}

    <!-- Project List -->
    {filteredProjects.length > 0 ? (
      <ProjectList projects={filteredProjects} />
    ) : (
      <div class="text-center py-12">
        <svg class="w-16 h-16 mx-auto text-gray-400 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
          No projects found
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          Try adjusting your filters or search terms
        </p>
        <a href="/learnt" class="btn-primary">
          Clear all filters
        </a>
      </div>
    )}

    <!-- Pagination placeholder for future enhancement -->
    {filteredProjects.length > 12 && (
      <div class="mt-12 text-center text-sm text-gray-500 dark:text-gray-400">
        Showing all {filteredProjects.length} projects
      </div>
    )}
  </section>

  <!-- Additional Info Section -->
  <section class="bg-gray-50 dark:bg-gray-800/50 border-t border-gray-200 dark:border-gray-700 py-12">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
          About This Archive
        </h2>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          This collection represents my learning journey as a developer. Every project here—whether
          successful, experimental, or sunset—taught me something valuable. I believe in documenting
          both wins and learning experiences, because that's how we grow.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about" class="btn-secondary">
            Learn More About Me
          </a>
          <a href="https://github.com/Nerajno" target="_blank" rel="noopener noreferrer" class="btn-ghost">
            View on GitHub →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Custom animations for filter badges */
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .inline-flex {
    animation: slideIn 0.2s ease-out;
  }
</style>