---
// #46: project detail page, composed from src/components/project/*.
import Layout from "../../layouts/Layout.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import DetailHeader from "../../components/project/DetailHeader.astro";
import SuccessorBanner from "../../components/project/SuccessorBanner.astro";
import Overview from "../../components/project/Overview.astro";
import ProofOfWork from "../../components/project/ProofOfWork.astro";
import Learned from "../../components/project/Learned.astro";
import DetailSidebar from "../../components/project/DetailSidebar.astro";
import SameSoil from "../../components/project/SameSoil.astro";
import { projects, getProjectBySlug, type Project } from "../../data/projects";
import { publicFileExists } from "../../lib/images";
import { projectJsonLd } from "../../lib/jsonld";
import { getLineage } from "../../lib/projects";
import { getNeighbours, getRelated } from "../../lib/detail";

export const getStaticPaths = () =>
  projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));

const { project } = Astro.props as { project: Project };

const successor = project.supersededBy ? getProjectBySlug(project.supersededBy) : undefined;
const { prev, next } = getNeighbours(project);

const longDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });

const hasShot = publicFileExists(project.screenshot);
const ogImage = hasShot ? project.screenshot ?? "/images/placeholder.png" : "/images/placeholder.png";
const jsonLd = projectJsonLd(
  project,
  new URL(Astro.url.pathname, Astro.site), // same as Layout's canonical link
  new URL(ogImage, Astro.site),
);
---

<Layout
  title={`${project.title} - Learnt Project`}
  description={project.short || project.description}
  image={project.screenshot}
  jsonLd={jsonLd}
>
  <article class="detail container-custom">
    <DetailHeader project={project} />
    <SuccessorBanner successor={successor} />

    {project.stage === "composted" && project.died && (
      <section class="composted" aria-labelledby="composted-h">
        <h2 id="composted-h">Composted</h2>
        <p>
          Work on this project stopped on <strong><time datetime={project.died}>{longDate(project.died)}</time></strong>.
          The code and what it taught me stay here as a reference.
        </p>
      </section>
    )}

    <div class="shot">
      <ProjectImage
        src={project.screenshot}
        alt={project.altText}
        title={project.title}
        slug={project.slug}
        loading="eager"
        heightClass={hasShot ? undefined : "h-40"}
        class={hasShot ? "w-full h-auto" : "w-full"}
      />
    </div>

    <div class="body">
      <div class="main">
        <Overview project={project} />
        <ProofOfWork project={project} />
        <Learned project={project} />
      </div>
      <DetailSidebar project={project} lineage={getLineage(project)} />
    </div>

    <SameSoil related={getRelated(project)} prev={prev} next={next} />

    <p class="report">
      <a href={`/contact?project=${encodeURIComponent(project.slug)}`} data-testid="report-link">
        Spot something wrong? Tell me
      </a>
    </p>
  </article>
</Layout>

<style>
  .detail {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 2rem 4rem;
  }
  .composted {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--warning);
    border-radius: var(--radius-sm);
    background: var(--bg-alt);
  }
  .composted h2 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-strong);
  }
  .composted p {
    margin: 0;
    color: var(--text-body);
  }
  .shot {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    gap: 2.5rem;
    align-items: start;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    min-width: 0;
  }
  .report {
    margin: 0;
    text-align: center;
    font-size: 0.875rem;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
